# ============================================================
# AcadMind AI — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Database (Supabase / PostgreSQL) ---
# Pooled connection (used by Prisma at runtime, e.g. via pgBouncer)
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma migrations — must NOT use pgBouncer)
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Server ---
NODE_ENV=development
# Port defaults to 5000 if not set
PORT=5000

# --- Authentication ---
# REQUIRED. Generate a strong secret: openssl rand -base64 64
# The server will fail to start if this is not set.
JWT_SECRET=
# Token expiry (default: 7d)
JWT_EXPIRES_IN=7d

# --- Frontend ---
# Comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:3000

# --- AI Providers ---
# Google Gemini API key (primary AI provider)
GEMINI_API_KEY=
# Groq API key (fallback AI provider — used when Gemini hits rate limits)
GROQ_API_KEY=

# --- Supabase (optional — for file storage) ---
# Not required for the current in-memory upload pipeline.
# Add when migrating to Supabase Storage for file persistence.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=