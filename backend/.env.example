# ============================================================
# AcadMind AI — Backend Environment Configuration
# ============================================================
# 1. Copy this file to `.env`:  cp .env.example .env
# 2. Fill in each value below.
# 3. Never commit `.env` to version control (it is gitignored).
# ============================================================

# ============================================================
# REQUIRED — the server will NOT start without these
# ============================================================

# --- Database (PostgreSQL / Supabase) ---
# Where to get it:
#   Supabase: Dashboard → Project Settings → Database → Connection string
#   Local:    your own PostgreSQL instance
#
# RENDER / SUPABASE DEPLOYMENT NOTES (transaction-mode pooler):
#   • DATABASE_URL uses the TRANSACTION pooler (port 6543) with `?pgbouncer=true`.
#     `pgbouncer=true` disables Prisma's named prepared statements (which the
#     transaction pooler does not support — this fixes the
#     `prepared statement "s4" does not exist` error). `connection_limit=1`
#     prevents socket starvation through the pooler.
#   • DIRECT_URL is used ONLY for `prisma migrate` and must point to a
#     connection that supports prepared statements: either the direct 5432
#     connection, or if unreachable over IPv6 from Render, the SESSION pooler
#     (also port 5432, host aws-0-[region].pooler.supabase.com, user
#     postgres.[project-ref]).
# Pooled connection (used by Prisma at runtime via transaction pooler — port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (used by Prisma migrations — port 5432, supports prepared statements)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Authentication ---
# Where to get it: generate one yourself
#   Run: openssl rand -base64 64
# The server fails to start if this is missing or set to the default placeholder.
JWT_SECRET=""

# ============================================================
# OPTIONAL — sensible defaults are used if omitted
# ============================================================

# --- Server ---
# development | production | test
NODE_ENV=development
# Port defaults to 5000 if not set
PORT=5000

# --- Authentication ---
# Token expiry (default: 7d). Use values like 15m, 1h, 7d
JWT_EXPIRES_IN=7d

# --- Frontend (CORS) ---
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000

# ============================================================
# AI PROVIDERS — required for AI upload/extraction features.
# The app runs without them (non-AI features work) but the
# AI pipeline will report "not_configured".
# ============================================================

# --- Primary AI Provider ---
# Which provider to use as the primary. Options: openrouter (default), gemini, groq
# openrouter runs Google Gemma 4 31B (free) through OpenRouter.
# The fallback chain is: primary → Gemini → Groq
AI_PROVIDER=openrouter

# --- AI Concurrency ---
# Maximum number of simultaneous AI provider requests across all uploads.
# Prevents a bulk upload (or several concurrent uploads) from exhausting
# provider quotas or timing out. Default: 3.
AI_MAX_CONCURRENCY=3

# --- OpenRouter (PRIMARY AI provider — Google Gemma 4 31B free) ---
# Where to get the API key: https://openrouter.ai/keys
# Click "Create Key" → copy the value.
# Model: google/gemma-4-31b-it:free (free tier, rate-limited)
OPENROUTER_API_KEY=""
# Optional: override the model or base URL (defaults shown below)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Gemini (FALLBACK AI provider) ---
# Where to get it: https://aistudio.google.com/apikey
# Click "Get API key" → Create API key → copy the value.
GEMINI_API_KEY=""

# --- Groq (SECONDARY FALLBACK AI provider) ---
# Where to get it: https://console.groq.com/keys
# Click "Create API Key" → copy the value.
GROQ_API_KEY=""

# ============================================================
# SUPABASE FILE STORAGE — OPTIONAL (not used by the current
# in-memory upload pipeline). Add these only if/when you move
# uploads to Supabase Storage.
# Where to get it:
#   SUPABASE_URL:         Dashboard → Project Settings → API → Project URL
#   SERVICE_ROLE_KEY:     Dashboard → Project Settings → API → Service Role (secret)
# ============================================================
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
