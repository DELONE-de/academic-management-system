# ============================================================
# AcadMind AI — Frontend Environment Configuration
# ============================================================
# 1. Copy this file to `.env.local`:  cp .env.example .env.local
# 2. Fill in each value below.
# 3. Never commit `.env.local` to version control.
# ============================================================

# --- Backend API URL ---
# Where to get it: the URL where your backend is running.
# Development: http://localhost:5000/api (default)
# Production:  https://your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ============================================================
# SUPABASE — OPTIONAL (only needed if using Supabase Auth or
# Storage instead of the JWT-based auth).
# Currently the system uses JWT + localStorage for auth.
# These are not required for the standard setup.
# Where to get it:
#   SUPABASE_URL:     Dashboard → Project Settings → API → Project URL
#   SUPABASE_ANON_KEY: Dashboard → Project Settings → API → Anon / Public key
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""